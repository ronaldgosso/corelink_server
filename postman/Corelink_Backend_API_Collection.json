              "mode": "raw",
              "raw": "{\n  \"content\": \"Scaling LinkedIn growth with automated AI scheduling has never been cleaner. \\n\\nBuilt with Supabase, Vercel, and Cloudflare Workers.\\n\\n#AI #Automation #Tech\",\n  \"scheduledAt\": \"2026-09-05T09:00:00.000Z\",\n  \"status\": \"pending\",\n  \"mediaUrl\": null,\n  \"mediaType\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
