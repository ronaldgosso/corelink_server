# ==============================================
# Corelink Server - Environment Variables Template
# ==============================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# CORS Configuration
CORS_ORIGIN=*

# LinkedIn OAuth 2.0 Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/auth/linkedin/callback

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mistral AI Engine
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Security & Encryption (AES-256-GCM Token Encryption & JWT)
# ENCRYPTION_KEY must be a 32-byte hexadecimal string (64 characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
JWT_SECRET=your_super_secret_jwt_signing_key

# Background Cron Security Key (Cloudflare Worker Dispatcher)
CRON_SECRET=your_shared_cron_worker_secret_key

# Upstash Redis Caching (Serverless REST API or Standard REDIS_URL)
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
# REDIS_URL=rediss://default:your_password@your-database-name.upstash.io:6379
