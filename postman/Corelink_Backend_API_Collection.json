              },
              {
                "key": "X-Timezone-Offset",
                "value": "180",
                "type": "text",
                "description": "Minutes offset from UTC (e.g. 180 for GMT+3)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentDraft\": \"We built a new scheduler using node and supabase.\",\n  \"style\": \"contrarian\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/generate/optimize-hook",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "generate",
                "optimize-hook"
              ]
            },
            "description": "### 2.2 Optimize Hook\n\nGenerates 3 high-converting alternative hooks for an existing draft."
          },
          "response": []
