              "body": "{\n  \"success\": true,\n  \"source\": \"REDIS\",\n  \"quota\": {\n    \"limit\": 10,\n    \"used\": 2,\n    \"remaining\": 8,\n    \"resetsAt\": \"2026-09-07T00:00:00.000+03:00\",\n    \"secondsRemaining\": 47280\n  }\n}"
            },
            {
              "name": "200 Success (Supabase DB Query)",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"source\": \"SUPABASE\",\n  \"quota\": {\n    \"limit\": 10,\n    \"used\": 2,\n    \"remaining\": 8,\n    \"resetsAt\": \"2026-09-07T00:00:00.000+03:00\",\n    \"secondsRemaining\": 47280\n  }\n}"
