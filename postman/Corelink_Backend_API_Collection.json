              "status": "Too Many Requests",
              "code": 429,
              "body": "{\n  \"success\": false,\n  \"error\": \"Daily AI generation limit reached (10/10). Resets at midnight in your local timezone.\",\n  \"quota\": {\n    \"limit\": 10,\n    \"used\": 10,\n    \"remaining\": 0,\n    \"resetsAt\": \"2026-09-07T00:00:00.000+03:00\",\n    \"secondsRemaining\": 47280\n  }\n}"
